# Django
SECRET_KEY=replace-with-a-long-random-secret-key-minimum-50-characters-123456
DEBUG=false
ALLOWED_HOSTS=yourdomain.com
TIMEZONE=UTC

# JWT
JWT_SECRET=replace-with-a-long-random-jwt-secret-key-1234567890

# Database
# For Docker Compose, web service overrides this to connect to db service
DATABASE_URL=postgres://careflow:careflow@localhost:5432/careflow
# Whether the Postgres connection above requires TLS. Deliberately NOT
# derived from DEBUG (see careflow/settings.py) — set true only for a
# managed Postgres reached over the public internet (e.g. Render); leave
# false for a same-Docker-network/CI Postgres container that doesn't speak
# SSL at all.
DATABASE_SSL_REQUIRE=false

# Redis (optional locally — enables Celery async dispatch + shared cache/
# throttle storage; unset means synchronous in-process processing and
# LocMemCache, which is correct for local dev/CI single-process runs)
REDIS_URL=
# CELERY_TASK_ALWAYS_EAGER defaults to true when REDIS_URL is unset (sync
# in-process execution), false otherwise. Override only if you need to
# force one behavior regardless of REDIS_URL.
CELERY_TASK_ALWAYS_EAGER=

# Security
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# CORS
CORS_ALLOWED_ORIGINS=https://yourfrontend.com,https://admin.yourfrontend.com

# Logging
LOG_LEVEL=INFO

# API throttling
DRF_THROTTLE_ANON=60/minute
DRF_THROTTLE_USER=300/minute
DRF_THROTTLE_PREDICT=20/minute
DRF_THROTTLE_TOKEN=10/minute

# Gunicorn tuning
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Optional demo bootstrap password
DEMO_PASSWORD=careflow-demo-strong-password
